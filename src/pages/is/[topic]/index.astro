---
/**
 * /is/<topic> — 테마 허브. 층(구역) 입장 카드 + 노드 종류 한 줄.
 * 층 안의 노드·이벤트는 구역 페이지(/zone/<id>)와 그 하위 노드 페이지(/zone/<id>/<type>)에서 본다.
 */
import Layout from '../../../layouts/Layout.astro';
import TopicHero from '../../../components/TopicHero.astro';
import NodeMap from '../../../components/NodeMap.astro';
import { loadTopics, loadMeta } from '../../../lib/data.mjs';

export function getStaticPaths() {
  return loadTopics().map((t) => ({ params: { topic: t.id }, props: { topic: t } }));
}
const { topic } = Astro.props;
const meta = loadMeta();
const eventTypes = Object.values(topic.nodeTypes).filter((t: any) => !t.pseudo && t.entryCount > 0);
const zoneStats = (z: any) => {
  const parts = [`노드 ${z.nodeTypes.length}종`];
  if (z.stageCount) parts.push(`전투 ${z.stageCount}`);
  if (z.floorEventCount) parts.push(`층 전용 이벤트 ${z.floorEventCount}`);
  return parts.join(' · ');
};
---

<Layout title={topic.name} topic={topic.id} topicName={topic.name} image={topic.kv} description={`${topic.name} — 구역 ${topic.counts.zones}, 이벤트 ${topic.counts.entryScenes}, 선택지 ${topic.counts.choices}, 전투 ${topic.counts.stages}, 엔딩 ${topic.counts.endings}`}>
  <TopicHero topic={topic} />
  <div class="container">
    <ul class="list-plain stats sans">
      <li><a href={`/is/${topic.id}/events`}><b>{topic.counts.entryScenes}</b> 이벤트</a></li>
      <li><b>{topic.counts.choices}</b> 선택지</li>
      <li><a href={`/is/${topic.id}/stages`}><b>{topic.counts.stages}</b> 전투</a></li>
      <li><a href={`/is/${topic.id}/endings`}><b>{topic.counts.endings}</b> 엔딩</a></li>
      <li><a href={`/is/${topic.id}/items`}><b>{topic.counts.items.toLocaleString()}</b> 소장품·아이템</a></li>
      <li><a href={`/is/${topic.id}/cutscenes`}><b>{topic.counts.cutscenes}</b> 컷신·기록</a></li>
    </ul>

    <div class="section-head">
      <h2>층</h2>
      <span class="small muted sans">층을 고르면 그 층의 노드가 나오고, 노드를 고르면 이벤트가 나옵니다</span>
    </div>
    <ol class="list-plain floors">
      {topic.zones.map((z: any, i: number) => (
        <li>
          <a class="floor card" href={`/is/${topic.id}/zone/${z.id}`}>
            <span class="floor__num sans">{i + 1}F</span>
            <span class="floor__body">
              <span class="floor__name">
                {z.name}
                {z.isHidden && <span class="badge badge--muted">숨겨진 구역</span>}
                {z.isLast && <span class="badge">최종</span>}
              </span>
              <span class="floor__desc">{z.description}</span>
              <span class="floor__stats sans small muted">{zoneStats(z)}</span>
            </span>
            <span class="floor__arrow sans" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    {topic.specialZones.length > 0 && (
      <details class="special">
        <summary class="sans">특수 구역 {topic.specialZones.length} <span class="muted small">포탈·변형·숨겨진 구역. 같은 이름은 하나로 묶음</span></summary>
        <ol class="list-plain floors">
          {topic.specialZones.map((z: any) => (
            <li>
              <a class="floor card" href={`/is/${topic.id}/zone/${z.id}`}>
                <span class="floor__num floor__num--sp sans">특수</span>
                <span class="floor__body">
                  <span class="floor__name">
                    {z.name}
                    {z.count > 1 && <span class="badge badge--muted">×{z.count}</span>}
                    {z.isHidden && <span class="badge badge--muted">숨겨진 구역</span>}
                  </span>
                  <span class="floor__desc">{z.description}</span>
                  <span class="floor__stats sans small muted">{zoneStats(z)}</span>
                </span>
                <span class="floor__arrow sans" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="section-head">
      <h2>노드 종류</h2>
      <a class="more" href={`/is/${topic.id}/events`}>층 구분 없이 이벤트 전체 보기 →</a>
    </div>
    <NodeMap types={eventTypes} hrefBase={`/is/${topic.id}/node/`} ui={meta.ui} />
  </div>
</Layout>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .stats b {
    color: var(--color-fg);
    font-size: 1.1rem;
    margin-right: 0.2rem;
  }
  .stats a {
    color: inherit;
  }
  .floors {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .floor {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1rem;
    color: var(--color-fg);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .floor:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateX(2px);
  }
  .floor__num {
    flex-shrink: 0;
    min-width: 3rem;
    text-align: center;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .floor__num--sp {
    font-size: 0.85rem;
    border-color: var(--color-muted);
    color: var(--color-muted);
  }
  .floor__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }
  .floor__name {
    font-weight: 700;
    font-size: 1.05rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .floor__desc {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .floor__arrow {
    color: var(--color-accent);
    font-size: 1.2rem;
    flex-shrink: 0;
  }
  .special {
    margin-top: 0.75rem;
  }
  .special summary {
    cursor: pointer;
    padding: 0.5rem 0;
    font-size: 0.95rem;
  }
  .special .floors {
    margin-top: 0.5rem;
  }
  @media (max-width: 600px) {
    .floor__arrow {
      display: none;
    }
  }
</style>
