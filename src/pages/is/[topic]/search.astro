---
/**
 * /is/<topic>/search — 테마 안에서 이벤트 이름으로 찾기 (클라이언트, 색인은 페이지에 포함).
 * ?q= 로 들어오면 바로 검색한다. 상단 테마 바의 검색창이 여기로 보낸다.
 */
import Layout from '../../../layouts/Layout.astro';
import TopicHero from '../../../components/TopicHero.astro';
import { loadTopics, loadScenes } from '../../../lib/data.mjs';

export function getStaticPaths() {
  return loadTopics().map((t) => ({ params: { topic: t.id }, props: { topic: t } }));
}
const { topic } = Astro.props;
const { scenes, groups } = loadScenes(topic.id);
const zoneName = Object.fromEntries([...topic.zones, ...topic.specialZones].map((z: any) => [z.id, z.name]));
// 이벤트 이름 색인: 묶음(같은 제목의 변형은 하나) 단위
const index = groups
  .filter((g: any) => g.title)
  .map((g: any) => ({
    id: g.ids[0],
    title: g.title,
    type: topic.nodeTypes[g.nodeType]?.name ?? g.nodeType,
    zone: g.zoneHint ? zoneName[g.zoneHint] ?? null : null,
    n: g.ids.length,
    choices: scenes[g.ids[0]]?.choices?.length ?? 0,
  }))
  .sort((a: any, b: any) => a.title.localeCompare(b.title, 'ko'));
---

<Layout title={`검색 · ${topic.name}`} topic={topic.id} topicName={topic.name} image={topic.kv} description={`${topic.name} 이벤트 이름 검색`}>
  <TopicHero topic={topic} compact />
  <div class="container container--narrow">
    <p class="crumbs"><span><a href={`/is/${topic.id}`}>{topic.name}</a></span><span>검색</span></p>
    <h1>이벤트 이름 검색 <span class="muted small sans">{index.length}</span></h1>
    <p class="muted small sans">이 테마의 이벤트 제목에서 찾습니다. 본문까지 찾으려면 <a href={`/search?q=`}>전체 검색</a>.</p>
    <input id="q" type="search" placeholder="이벤트 이름" autofocus aria-label="이벤트 이름" autocomplete="off" />
    <p class="muted small sans" id="status"></p>
    <ol class="list-plain results" id="results"></ol>
  </div>
</Layout>

<script define:vars={{ index, topicId: topic.id }}>
  const q = document.getElementById('q');
  const results = document.getElementById('results');
  const status = document.getElementById('status');
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const mark = (s, term) => {
    const i = s.toLowerCase().indexOf(term);
    if (i < 0) return esc(s);
    return `${esc(s.slice(0, i))}<mark>${esc(s.slice(i, i + term.length))}</mark>${esc(s.slice(i + term.length))}`;
  };
  const render = (list, term) => {
    results.innerHTML = list
      .map(
        (e) =>
          `<li class="hit"><a href="/is/${topicId}/scene/${e.id}"><b>${mark(e.title, term)}</b>${e.n > 1 ? ` <span class="badge badge--info">×${e.n}</span>` : ''}<span class="hit__meta">${esc(e.type)}${e.zone ? ` · ${esc(e.zone)}` : ''} · 선택지 ${e.choices}</span></a></li>`,
      )
      .join('');
  };
  const run = () => {
    const term = q.value.trim().toLowerCase();
    if (!term) {
      status.textContent = '한 글자 이상 입력하면 바로 찾습니다. 비워 두면 전체 목록.';
      render(index, '');
      return;
    }
    const hits = index.filter((e) => e.title.toLowerCase().includes(term));
    status.textContent = hits.length ? `${hits.length}건` : '맞는 이벤트가 없습니다.';
    render(hits, term);
  };
  q.addEventListener('input', () => {
    run();
    const u = new URL(location.href);
    if (q.value.trim()) u.searchParams.set('q', q.value.trim());
    else u.searchParams.delete('q');
    history.replaceState(null, '', u);
  });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) q.value = initial;
  run();
</script>

<style>
  #q {
    font: inherit;
    width: 100%;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-fg);
    font-size: 1.05rem;
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .results :global(.hit a) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-fg);
  }
  .results :global(.hit a:hover) {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .results :global(.hit__meta) {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .results :global(mark) {
    background: var(--color-accent-soft);
    color: inherit;
    padding: 0 0.1em;
  }
</style>
