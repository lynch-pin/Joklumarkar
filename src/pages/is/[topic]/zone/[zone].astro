---
/**
 * /is/<topic>/zone/<zone> — 층(구역) 입구. 이 층에 나오는 노드를 고르는 페이지.
 * 이벤트 본문은 여기 늘어놓지 않고, 노드마다 하위 페이지(/zone/<zone>/<type>)로 보낸다.
 */
import Layout from '../../../../layouts/Layout.astro';
import TopicHero from '../../../../components/TopicHero.astro';
import NodeMap from '../../../../components/NodeMap.astro';
import { loadTopics, loadScenes, loadStages, loadMeta } from '../../../../lib/data.mjs';

export function getStaticPaths() {
  return loadTopics().flatMap((t) => [
    ...t.zones.map((z: any, i: number) => ({ params: { topic: t.id, zone: z.id }, props: { topic: t, zone: z, floor: i + 1 } })),
    ...t.specialZones.map((z: any) => ({ params: { topic: t.id, zone: z.id }, props: { topic: t, zone: z, floor: 0 } })),
  ]);
}
const { topic, zone, floor } = Astro.props;
const meta = loadMeta();
const { groups } = loadScenes(topic.id);
const stages = loadStages(topic.id);
const types = zone.nodeTypes.map((k: string) => topic.nodeTypes[k]).filter(Boolean);
const prev = floor ? topic.zones[floor - 2] ?? null : null;
const next = floor ? topic.zones[floor] ?? null : null;
const floorLabel = floor ? `${floor}F` : '특수';
const base = `/is/${topic.id}/zone/${zone.id}/`;

// 노드별 집계: 이 층 전용 묶음 / 공통 묶음 / 이 층의 전투 수
const floorStages = stages.filter((s: any) => s.zoneHint === zone.id);
const kindOf = (key: string) => (key === 'BATTLE_BOSS' ? 'boss' : key === 'BATTLE_ELITE' ? 'elite' : key === 'BATTLE_NORMAL' ? 'normal' : null);
const rows = types.map((t: any) => {
  const own = groups.filter((g: any) => g.nodeType === t.key && g.zoneHint === zone.id).length;
  const common = groups.filter((g: any) => g.nodeType === t.key && g.zoneHint !== zone.id).length;
  const kind = kindOf(t.key);
  const battles = kind ? floorStages.filter((s: any) => s.kind === kind).length : 0;
  return { t, own, common, battles, kind };
});
const previewCount = floorStages.filter((s: any) => s.mapPreview).length;
---

<Layout title={`${zone.name} · ${topic.name}`} topic={topic.id} topicName={topic.name} image={topic.kv} description={zone.description}>
  <TopicHero topic={topic} compact />
  <div class="container">
    <p class="crumbs"><span><a href={`/is/${topic.id}`}>{topic.name}</a></span><span>{floorLabel} {zone.name}</span></p>

    <header class="zhead">
      <h1>
        <span class="zhead__floor sans">{floorLabel}</span> {zone.name}
        {zone.count > 1 && <span class="badge badge--muted" title={zone.ids.join(', ')}>변형 ×{zone.count}</span>}
        {zone.isLast && <span class="badge">최종 구역</span>}
      </h1>
      <p class="zhead__desc">{zone.description}</p>
      {zone.buffDescription && <p class="small"><b>구역 효과</b> {zone.buffDescription}</p>}
      {zone.endingDescription && <p class="small muted"><b>이탈 문구</b> {zone.endingDescription}</p>}
      <nav class="zhead__nav sans small">
        {prev ? <a href={`/is/${topic.id}/zone/${prev.id}`}>← {floor - 1}F {prev.name}</a> : <span />}
        {next ? <a href={`/is/${topic.id}/zone/${next.id}`}>{floor + 1}F {next.name} →</a> : <span />}
      </nav>
    </header>

    <div class="section-head">
      <h2>이 층의 노드</h2>
      <span class="small muted sans">{zone.nodeTypesSource === 'data' ? '게임 데이터 기준' : '구역별 데이터 없음 — 테마 전체 종류'} · 노드를 누르면 그 노드의 이벤트가 열립니다</span>
    </div>
    <NodeMap types={types} hrefBase={base} ui={meta.ui} showCount={false} />

    <ul class="list-plain nodes">
      {rows.map(({ t, own, common, battles, kind }: any) => (
        <li>
          <a class="nrow card" href={`${base}${t.key}`}>
            {t.active ? <img class="nrow__icon" src={t.active} alt="" loading="lazy" decoding="async" /> : <span class="nrow__icon nrow__icon--ph" />}
            <span class="nrow__body">
              <span class="nrow__name">
                <b>{t.name}</b>
                {t.tag && <img class="tagimg" src={t.tag} alt="" loading="lazy" decoding="async" />}
              </span>
              <span class="nrow__desc small muted">{t.description}</span>
            </span>
            <span class="nrow__count sans small">
              {kind ? (
                battles ? <>전투 {battles}{previewCount ? ' · 맵 프리뷰' : ''}</> : <span class="muted">이 층 고정 전투 없음</span>
              ) : (
                <>
                  {own > 0 && <span class="nrow__own">층 전용 {own}</span>}
                  {own > 0 && common > 0 && ' · '}
                  {common > 0 && <>공통 {common}</>}
                  {!own && !common && <span class="muted">이벤트 없음</span>}
                </>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .zhead h1 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .zhead__floor {
    font-size: 0.8rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 3px;
  }
  .zhead__desc {
    margin: 0 0 0.5rem;
    font-size: 1.02rem;
  }
  .zhead p {
    margin: 0.2rem 0;
  }
  .zhead__nav {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
  }
  .nodes {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    margin-top: 0.75rem;
  }
  .nrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    color: var(--color-fg);
    text-decoration: none;
    height: 100%;
    transition: border-color 0.15s;
  }
  .nrow:hover {
    text-decoration: none;
    border-color: var(--color-accent);
  }
  .nrow__icon {
    height: 1.6rem;
    width: 2.6rem;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6));
    background: var(--color-hero);
    border-radius: 4px;
    padding: 0.2rem;
  }
  .nrow__icon--ph {
    background: var(--color-card-2);
  }
  .nrow__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }
  .nrow__name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .nrow__name b {
    white-space: nowrap;
  }
  .nrow__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nrow__count {
    flex-shrink: 0;
    text-align: right;
    color: var(--color-muted);
  }
  .nrow__own {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
